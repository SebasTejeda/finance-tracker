# ==========================================
# REGLAS GLOBALES (Para editores e IDEs)
# ==========================================
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
*.log

# ==========================================
# REGLAS PARA EL BACKEND (Python / FastAPI)
# ==========================================
backend/__pycache__/
backend/app/__pycache__/
backend/*.py[cod]
backend/.venv/
backend/venv/
backend/.env
backend/*.db
backend/.pytest_cache/

# ==========================================
